+
+torch::Tensor faster_gs::rasterization::n_touched_tiles_wrapper(const torch::Tensor& primitive_buffers, const int n_primitives)
+{
+    const torch::TensorOptions int_options = torch::TensorOptions().dtype(torch::kInt).device(torch::kCUDA);
+    if (n_primitives == 0) return torch::empty({0}, int_options);
+    char* blob = reinterpret_cast<char*>(primitive_buffers.data_ptr());
+    PrimitiveBuffers buffers = PrimitiveBuffers::from_blob(blob, n_primitives);
+    return torch::from_blob(buffers.n_touched_tiles, {n_primitives}, int_options).clone();
+}
