+
+// ---------------------------------------------------------------------------------------------
+// lean Adam: visibility-sparse update + optional bfloat16 moments with stochastic rounding
+// ---------------------------------------------------------------------------------------------
+namespace faster_gs::adam {
+
+    __device__ __forceinline__ uint32_t hash_u32(uint32_t x) {
+        x ^= x >> 16; x *= 0x7feb352du; x ^= x >> 15; x *= 0x846ca68bu; x ^= x >> 16;
+        return x;
+    }
+
+    __device__ __forceinline__ float bf16_bits_to_float(const uint16_t b) {
+        return __uint_as_float(static_cast<uint32_t>(b) << 16);
+    }
+
+    // round-to-bfloat16 with stochastic rounding: add uniform noise to the 16 dropped bits, then truncate.
+    // unbiased in expectation, so slowly-decaying EMAs (beta2 = 0.999) do not stall at bf16 resolution.
+    __device__ __forceinline__ uint16_t float_to_bf16_bits_sr(const float f, const uint32_t rnd) {
+        const uint32_t u = __float_as_uint(f);
+        return static_cast<uint16_t>((u + (rnd & 0xFFFFu)) >> 16);
+    }
+
+    template <bool LOWP>
+    __global__ void adam_step_sparse_cu(
+        const float* __restrict__ param_grad,
+        float* __restrict__ param,
+        void* __restrict__ exp_avg_raw,
+        void* __restrict__ exp_avg_sq_raw,
+        const int* __restrict__ visibility,
+        const long long n_elements,
+        const int features_per_primitive,
+        const float step_size,
+        const float beta1,
+        const float beta2,
+        const float epsilon,
+        const float bias_correction2_sqrt_rcp,
+        const uint32_t seed)
+    {
+        const long long idx = static_cast<long long>(blockIdx.x) * blockDim.x + threadIdx.x;
+        if (idx >= n_elements) return;
+        if (visibility != nullptr && visibility[idx / features_per_primitive] == 0) return;
+        const float grad = param_grad[idx];
+        float exp, exp_sq;
+        if constexpr (LOWP) {
+            exp = bf16_bits_to_float(static_cast<const uint16_t*>(exp_avg_raw)[idx]);
+            exp_sq = bf16_bits_to_float(static_cast<const uint16_t*>(exp_avg_sq_raw)[idx]);
+        } else {
+            exp = static_cast<const float*>(exp_avg_raw)[idx];
+            exp_sq = static_cast<const float*>(exp_avg_sq_raw)[idx];
+        }
+        const float grad_sq = grad * grad;
+        const float moment1 = fmaf(beta1, exp - grad, grad);
+        const float moment2 = fmaf(beta2, exp_sq - grad_sq, grad_sq);
+        const float denom = sqrtf(moment2) * bias_correction2_sqrt_rcp + epsilon;
+        param[idx] -= step_size * moment1 / denom;
+        if constexpr (LOWP) {
+            const uint32_t r1 = hash_u32(static_cast<uint32_t>(idx) ^ seed);
+            const uint32_t r2 = hash_u32(r1);
+            static_cast<uint16_t*>(exp_avg_raw)[idx] = float_to_bf16_bits_sr(moment1, r1);
+            static_cast<uint16_t*>(exp_avg_sq_raw)[idx] = float_to_bf16_bits_sr(moment2, r2);
+        } else {
+            static_cast<float*>(exp_avg_raw)[idx] = moment1;
+            static_cast<float*>(exp_avg_sq_raw)[idx] = moment2;
+        }
+    }
+
+    void adam_step_sparse_wrapper(
+        const torch::Tensor& param_grad,
+        torch::Tensor& param,
+        torch::Tensor& exp_avg,
+        torch::Tensor& exp_avg_sq,
+        const torch::Tensor& visibility,
+        const int step_count,
+        const double learning_rate,
+        const double beta1,
+        const double beta2,
+        const double epsilon)
+    {
+        TORCH_CHECK(param.is_cuda() && param.is_contiguous() && param.scalar_type() == torch::kFloat, "param must be contiguous float32 CUDA");
+        TORCH_CHECK(param_grad.is_contiguous() && param_grad.scalar_type() == torch::kFloat && param_grad.numel() == param.numel(), "bad grad");
+        TORCH_CHECK(exp_avg.scalar_type() == exp_avg_sq.scalar_type(), "exp_avg and exp_avg_sq must share a dtype");
+        TORCH_CHECK(exp_avg.is_contiguous() && exp_avg_sq.is_contiguous() && exp_avg.numel() == param.numel() && exp_avg_sq.numel() == param.numel(), "bad moments");
+        const bool lowp = exp_avg.scalar_type() == torch::kBFloat16;
+        TORCH_CHECK(lowp || exp_avg.scalar_type() == torch::kFloat, "moments must be float32 or bfloat16");
+
+        const long long n_elements = param.numel();
+        if (n_elements == 0) return;
+        const int n_primitives = param.size(0);
+        const int features_per_primitive = static_cast<int>(n_elements / n_primitives);
+        const int* vis = nullptr;
+        if (visibility.numel() > 0) {
+            TORCH_CHECK(visibility.is_cuda() && visibility.is_contiguous() && visibility.scalar_type() == torch::kInt && visibility.numel() == n_primitives,
+                        "visibility must be int32 [n_primitives] on CUDA");
+            vis = visibility.data_ptr<int>();
+        }
+
+        const double bias_correction1_rcp = 1.0 / (1.0 - std::pow(beta1, step_count));
+        const double bias_correction2_sqrt_rcp = 1.0 / std::sqrt(1.0 - std::pow(beta2, step_count));
+        const double step_size = learning_rate * bias_correction1_rcp;
+        const uint32_t seed = 0x9E3779B9u * static_cast<uint32_t>(step_count) + 0x85EBCA6Bu;
+
+        const int blocks = static_cast<int>((n_elements + config::block_size_adam_step - 1) / config::block_size_adam_step);
+        if (lowp) {
+            adam_step_sparse_cu<true><<<blocks, config::block_size_adam_step>>>(
+                param_grad.data_ptr<float>(), param.data_ptr<float>(), exp_avg.data_ptr(), exp_avg_sq.data_ptr(), vis,
+                n_elements, features_per_primitive, static_cast<float>(step_size), static_cast<float>(beta1), static_cast<float>(beta2),
+                static_cast<float>(epsilon), static_cast<float>(bias_correction2_sqrt_rcp), seed);
+        } else {
+            adam_step_sparse_cu<false><<<blocks, config::block_size_adam_step>>>(
+                param_grad.data_ptr<float>(), param.data_ptr<float>(), exp_avg.data_ptr(), exp_avg_sq.data_ptr(), vis,
+                n_elements, features_per_primitive, static_cast<float>(step_size), static_cast<float>(beta1), static_cast<float>(beta2),
+                static_cast<float>(epsilon), static_cast<float>(bias_correction2_sqrt_rcp), seed);
+        }
+        CHECK_CUDA(config::debug, "adam_step_sparse")
+    }
+
+}
