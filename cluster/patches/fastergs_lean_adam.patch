 class FusedAdam(torch.optim.Adam):
-    def __init__(self, params, lr, eps) -> None:
+    """Fused Adam over single-tensor parameter groups.
+
+    sparse: only update primitives visible in the last differentiable forward pass (n_touched_tiles > 0);
+            invisible primitives keep their parameters and moments unchanged for that step.
+    lowp_moment_groups: names of parameter groups whose exp_avg / exp_avg_sq are kept in bfloat16
+            (stochastic rounding on write).
+    With both off, this is the original Faster-GS optimizer (same kernel).
+    """
+
+    def __init__(self, params, lr, eps, sparse: bool = False, lowp_moment_groups: tuple = ()) -> None:
         super().__init__(params=params, lr=lr, eps=eps)
+        self.sparse = sparse
+        self.lowp_moment_groups = set(lowp_moment_groups)
+        self.lean = sparse or bool(self.lowp_moment_groups)
+        self.n_dense_fallbacks = 0
+        _Rasterize.track_visibility = sparse
 
     @torch.no_grad()
     def step(self) -> None:
+        visibility = _Rasterize.last_visibility if self.sparse else None
         for group in self.param_groups:
             assert len(group['params']) == 1, 'more than one tensor in group'
             param = group['params'][0]
@@ -16,19 +32,47 @@ class FusedAdam(torch.optim.Adam):
             if param.grad is None or param.numel() == 0:
                 continue
 
+            lowp = group.get('name') in self.lowp_moment_groups
+            moment_dtype = torch.bfloat16 if lowp else param.dtype
             state = self.state[param]
             if len(state) == 0:
                 state['step'] = 0
-                state['exp_avg'] = torch.zeros_like(param)
-                state['exp_avg_sq'] = torch.zeros_like(param)
+                state['exp_avg'] = torch.zeros_like(param, dtype=moment_dtype)
+                state['exp_avg_sq'] = torch.zeros_like(param, dtype=moment_dtype)
+            elif lowp and state['exp_avg'].dtype != moment_dtype:
+                # densification utilities concatenate float32 zeros, which promotes the moments; convert back
+                state['exp_avg'] = state['exp_avg'].to(moment_dtype)
+                state['exp_avg_sq'] = state['exp_avg_sq'].to(moment_dtype)
 
             state['step'] += 1
 
-            _C.adam_step(
+            if not self.lean:
+                _C.adam_step(
+                    param.grad,
+                    param,
+                    state['exp_avg'],
+                    state['exp_avg_sq'],
+                    state['step'],
+                    group['lr'],
+                    *group['betas'],
+                    group['eps'],
+                )
+                continue
+
+            vis = visibility
+            if vis is not None and group.get('name') == 'means' and state['step'] % 1000 == 0:
+                # occasional (host-syncing) log of the visible fraction; every 1000 steps only
+                print(f'VISFRAC step={state["step"]} visible={int(vis.count_nonzero())} total={vis.numel()} '
+                      f'frac={int(vis.count_nonzero()) / max(vis.numel(), 1):.3f}', flush=True)
+            if vis is not None and vis.numel() != param.shape[0]:
+                vis = None  # stale mask (should not happen inside training_iteration); fall back to dense
+                self.n_dense_fallbacks += 1
+            _C.adam_step_sparse(
                 param.grad,
                 param,
                 state['exp_avg'],
                 state['exp_avg_sq'],
+                vis if vis is not None else torch.empty(0, dtype=torch.int32, device=param.device),
                 state['step'],
                 group['lr'],
                 *group['betas'],
