@@ -4,6 +4,56 @@
 #include "rasterization_config.h"
 #include "utils.h"
 #include "helper_math.h"
+#include <type_traits>
+
+// Phase 1 macro blend backward. blend_backward_mode bits: 1 = macro kernel, 2 = subtile skip,
+// 4 = transposing warp reduction, 8 = 8 warps per block (else 4).
+template <bool abs_grad, int n_warps, bool subtile_skip, bool transpose_reduce, typename... Args>
+static void launch_macro_variant(const int n_buckets, Args... args) {
+    faster_gs::rasterization::kernels::backward::blend_backward_macro_cu<abs_grad, n_warps, subtile_skip, transpose_reduce>
+        <<<div_round_up(n_buckets, n_warps), 32 * n_warps>>>(args...);
+}
+
+template <bool abs_grad, int n_warps, bool subtile_skip, typename... Args>
+static void dispatch_macro_reduce(const int mode, const int n_buckets, Args... args) {
+    if (mode & 4) launch_macro_variant<abs_grad, n_warps, subtile_skip, true>(n_buckets, args...);
+    else launch_macro_variant<abs_grad, n_warps, subtile_skip, false>(n_buckets, args...);
+}
+
+template <bool abs_grad, int n_warps, typename... Args>
+static void dispatch_macro_skip(const int mode, const int n_buckets, Args... args) {
+    if (mode & 2) dispatch_macro_reduce<abs_grad, n_warps, true>(mode, n_buckets, args...);
+    else dispatch_macro_reduce<abs_grad, n_warps, false>(mode, n_buckets, args...);
+}
+
+template <bool abs_grad, typename... Args>
+static void dispatch_macro_warps(const int mode, const int n_buckets, Args... args) {
+    if (mode & 8) dispatch_macro_skip<abs_grad, 8>(mode, n_buckets, args...);
+    else dispatch_macro_skip<abs_grad, 4>(mode, n_buckets, args...);
+}
+
+static void launch_blend_backward_macro(
+    const int mode, const bool abs_grad,
+    const uint2* tile_instance_ranges, const uint* tile_bucket_offsets, const uint* instance_primitive_indices,
+    const ushort4* primitive_screen_bounds, const float2* primitive_mean2d, const float4* primitive_conic_opacity,
+    const float3* primitive_color, const float* grad_image, const float* image, const uint* tile_max_n_processed,
+    const uint* tile_n_processed, const uint* bucket_tile_index, const float4* bucket_color_transmittance,
+    float2* grad_mean2d, float* grad_conic, float* grad_opacity, float3* grad_sh_coefficients_0, float2* grad_mean2d_abs,
+    const int n_buckets, const int n_primitives, const int width, const int height, const uint grid_width,
+    const bool proper_antialiasing)
+{
+    auto go = [&](auto abs_tag) {
