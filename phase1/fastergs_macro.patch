+# Phase 1 (3dgs-project): blend backward selection and in-training checks.
+#   FGS_BLEND_BWD=macro|taming   blend backward kernel (default macro; taming = stock Faster-GS kernel)
+#   FGS_GRADCHECK_EVERY=n        every n-th backward call also runs the other kernel on the same forward buffers and
+#                                prints GRADCHECK lines: norm-based rel error of each gradient (reference = taming)
+#   FGS_BWDTIME_REPS=k           on those calls, also time k runs of _C.backward per kernel (CUDA events, median ms)
+BLEND_BACKWARD_MODES = {'taming': 0, 'macro': 1}
+BLEND_BACKWARD_MODE = BLEND_BACKWARD_MODES[os.environ.get('FGS_BLEND_BWD', 'macro')]
+_GRADCHECK_EVERY = int(os.environ.get('FGS_GRADCHECK_EVERY', '0'))
+_BWDTIME_REPS = int(os.environ.get('FGS_BWDTIME_REPS', '0'))
+_GRAD_NAMES = ('means', 'scales', 'rotations', 'opacities', 'sh0', 'sh_rest')
+_n_backward_calls = 0
+
+
+def rel_error(a: torch.Tensor, b: torch.Tensor) -> float:
+    """||a - b|| / ||b|| in float64 (0 if both are zero)."""
+    a, b = a.double().flatten(), b.double().flatten()
+    nb = torch.linalg.vector_norm(b).item()
+    nd = torch.linalg.vector_norm(a - b).item()
+    return nd / nb if nb > 0 else nd
+
+
+def _backward_call(args_head: tuple, densification_info: torch.Tensor, args_tail: tuple, mode: int) -> tuple:
+    return _C.backward(densification_info, *args_head, *args_tail, mode)
+
+
+def _check_and_time(args_head: tuple, densification_info: torch.Tensor, args_tail: tuple, grads: tuple,
+                    densification_info_before: torch.Tensor, mode: int) -> None:
+    other = 1 - mode
+    di_other = densification_info_before.clone()
+    grads_other = _backward_call(args_head, di_other, args_tail, other)
+    macro, taming = (grads, grads_other) if mode == 1 else (grads_other, grads)
+    errs = {name: rel_error(m, t) for name, m, t in zip(_GRAD_NAMES, macro, taming)}
+    if densification_info.numel() > 0:
+        d_mode = densification_info - densification_info_before
+        d_other = di_other - densification_info_before
+        d_macro, d_taming = (d_mode, d_other) if mode == 1 else (d_other, d_mode)
+        for row in range(d_macro.shape[0]):
+            errs[f'densify{row}'] = rel_error(d_macro[row], d_taming[row])
+    line = ' '.join(f'{k}={v:.3e}' for k, v in errs.items())
+    print(f'GRADCHECK call={_n_backward_calls} n={args_head[2].shape[0]} max={max(errs.values()):.3e} {line}', flush=True)
+    if _BWDTIME_REPS > 0:
+        times = {}
+        for name, m in BLEND_BACKWARD_MODES.items():
+            ms = []
+            for _ in range(_BWDTIME_REPS):
+                di = densification_info_before.clone()
+                start, end = torch.cuda.Event(enable_timing=True), torch.cuda.Event(enable_timing=True)
+                start.record()
+                _backward_call(args_head, di, args_tail, m)
+                end.record()
+                torch.cuda.synchronize()
+                ms.append(start.elapsed_time(end))
+            times[name] = sorted(ms)[len(ms) // 2]
+        print(f'BWDTIME call={_n_backward_calls} n={args_head[2].shape[0]} taming_ms={times["taming"]:.4f} '
+              f'macro_ms={times["macro"]:.4f} speedup={times["taming"] / times["macro"]:.3f}', flush=True)
+
