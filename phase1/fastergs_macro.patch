+    // Phase 1 (3dgs-project): the Phase 0 "backward B" work layout for the same bucket data.
+    // One warp per (tile, 32-splat bucket), n_warps warps per block. Each lane owns
+    // macro_pixels_per_lane = 6 pixels of the 16x12 tile (local = r * 32 + lane, i.e. column lane % 16,
+    // row 2r + lane / 16) and loops over the bucket's splats; per pixel it keeps only
+    //   T   - transmittance, from the bucket checkpoint, updated exactly like the forward,
+    //   rho - G . (image - C), image including the background, so that
+    //         dL/dalpha_j = T_j (G . c_j) - rho_after_j / (1 - alpha_j)
+    //         (this folds stock's grad_alpha_common = -T_final G . bg into rho),
+    //   lim - how many splats of this bucket the pixel used in the forward (n_processed - bucket start).
+    // Per splat the lanes sum their pixels' terms, the warp reduces, and the same atomics as
+    // blend_backward_cu are issued (one per (bucket, splat, value)); splats no pixel used are skipped by ballot.
+    // Options (template):
+    //   subtile_skip      skip a pixel for a splat whose screen bounds miss the pixel's 8x4 subtile, exactly
+    //                     the culling blend_cu applies, so the replay sees the forward's splat sequence; a
+    //                     2-row band whose subtile row misses is skipped by the whole warp
+    //   transpose_reduce  reduce the 8 (mean2d, conic, color) sums with a transposing butterfly (9 shuffles)
+    //                     and opacity (+ |mean2d|) with a second one (5-6 shuffles) instead of 5 shuffles per
+    //                     value; the atomics are then issued by 8-11 lanes in parallel
+    template <bool compute_abs_grad, int n_warps, bool subtile_skip, bool transpose_reduce>
+    __global__ void __launch_bounds__(32 * n_warps) blend_backward_macro_cu(
+        const uint2* __restrict__ tile_instance_ranges,
+        const uint* __restrict__ tile_bucket_offsets,
+        const uint* __restrict__ instance_primitive_indices,
+        const ushort4* __restrict__ primitive_screen_bounds,
+        const float2* __restrict__ primitive_mean2d,
+        const float4* __restrict__ primitive_conic_opacity,
+        const float3* __restrict__ primitive_color,
+        const float* __restrict__ grad_image,
+        const float* __restrict__ image,
+        const uint* __restrict__ tile_max_n_processed,
+        const uint* __restrict__ tile_n_processed,
+        const uint* __restrict__ bucket_tile_index,
+        const float4* __restrict__ bucket_color_transmittance,
+        float2* __restrict__ grad_mean2d,
+        float* __restrict__ grad_conic,
+        float* __restrict__ grad_opacity,
+        float3* __restrict__ grad_sh_coefficients_0,
+        float2* __restrict__ grad_mean2d_abs,
+        const uint n_buckets,
+        const uint n_primitives,
+        const uint width,
+        const uint height,
+        const uint grid_width,
+        const bool proper_antialiasing)
+    {
+        constexpr int n_px = config::macro_pixels_per_lane;
+        constexpr uint full_mask = 0xffffffffu;
+        static_assert(n_px * 32 == config::block_size_blend, "tile must hold 32 * n_px pixels");
+        static_assert(32 % config::tile_width == 0, "a lane must keep one column of the tile");
+        constexpr int rows_per_step = 32 / config::tile_width; // 2
+        static_assert(config::subtile_height % rows_per_step == 0, "a row band must lie in one subtile row");
+        constexpr int steps_per_subtile_row = config::subtile_height / rows_per_step; // 2
+        constexpr int n_subtile_rows = config::tile_height / config::subtile_height; // 3
+
+        __shared__ float2 s_mean2d[n_warps][32];
+        __shared__ float4 s_conic_opacity[n_warps][32];
+        __shared__ float3 s_color[n_warps][32];
+        __shared__ uint s_primitive_idx[n_warps][32];
+        __shared__ uint s_flags[n_warps][32]; // bits 0-2: color >= 0 mask; 3-4: x subtile halves hit; 5-7: subtile rows hit
+        __shared__ float3 s_grad[n_warps][config::block_size_blend];
+
+        const uint warp_idx = threadIdx.x / 32;
+        const uint lane_idx = threadIdx.x % 32;
+        const uint bucket_idx = blockIdx.x * n_warps + warp_idx;
+        if (bucket_idx >= n_buckets) return; // whole warp; warps never sync with each other
+
+        const uint tile_idx = bucket_tile_index[bucket_idx];
+        const uint2 tile_range = tile_instance_ranges[tile_idx];
+        const uint tile_first_bucket = (tile_idx == 0) ? 0 : tile_bucket_offsets[tile_idx - 1];
+        const int bucket_start = static_cast<int>(bucket_idx - tile_first_bucket) * 32;
+        const int max_n_processed = static_cast<int>(tile_max_n_processed[tile_idx]);
+        if (bucket_start >= max_n_processed) return;
+        const int bucket_size = min(32, max_n_processed - bucket_start); // <= tile list length
+        const uint2 tile_coords = {tile_idx % grid_width, tile_idx / grid_width};
+        const uint tile_x0 = tile_coords.x * config::tile_width;
+        const uint tile_y0 = tile_coords.y * config::tile_height;
+
+        // stage the bucket's splats
+        if (static_cast<int>(lane_idx) < bucket_size) {
+            const uint primitive_idx = instance_primitive_indices[tile_range.x + bucket_start + lane_idx];
+            s_primitive_idx[warp_idx][lane_idx] = primitive_idx;
+            s_mean2d[warp_idx][lane_idx] = primitive_mean2d[primitive_idx];
+            s_conic_opacity[warp_idx][lane_idx] = primitive_conic_opacity[primitive_idx];
+            const float3 color_unclamped = primitive_color[primitive_idx];
+            s_color[warp_idx][lane_idx] = fmaxf(color_unclamped, 0.0f);
+            uint flags = (color_unclamped.x >= 0.0f ? 1u : 0u) | (color_unclamped.y >= 0.0f ? 2u : 0u) | (color_unclamped.z >= 0.0f ? 4u : 0u);
+            if constexpr (subtile_skip) {
+                // same overlap test as blend_cu, per subtile column / row of this tile
+                const ushort4 sb = primitive_screen_bounds[primitive_idx];
+                #pragma unroll
+                for (int sx = 0; sx < config::subgrid_width; ++sx) {
+                    const uint x_min = tile_x0 + sx * config::subtile_width;
+                    if (sb.x < x_min + config::subtile_width && x_min < sb.y) flags |= 8u << sx;
+                }
+                #pragma unroll
+                for (int sy = 0; sy < n_subtile_rows; ++sy) {
+                    const uint y_min = tile_y0 + sy * config::subtile_height;
+                    if (sb.z < y_min + config::subtile_height && y_min < sb.w) flags |= 32u << sy;
+                }
+            }
+            s_flags[warp_idx][lane_idx] = flags;
+        }
+
+        // per-pixel state from the bucket checkpoint
+        const uint pixel_x = tile_x0 + lane_idx % config::tile_width;
+        const uint pixel_y0 = tile_y0 + lane_idx / config::tile_width;
+        const uint x_half_bit = 8u << ((lane_idx % config::tile_width) / config::subtile_width);
+        const float pixel_xf = __uint2float_rn(pixel_x) + 0.5f;
+        const uint n_pixels = width * height;
+        const float4* checkpoint = bucket_color_transmittance + static_cast<size_t>(bucket_idx) * config::block_size_blend;
+        float T[n_px];
+        float rho[n_px];
+        int lim[n_px];
+        #pragma unroll
+        for (int r = 0; r < n_px; ++r) {
+            const uint local_idx = r * 32 + lane_idx;
+            const uint pixel_y = pixel_y0 + r * rows_per_step;
+            float3 G = make_float3(0.0f);
+            T[r] = 0.0f;
+            rho[r] = 0.0f;
+            lim[r] = 0;
+            if (pixel_x < width && pixel_y < height) {
+                const uint pixel_idx = width * pixel_y + pixel_x;
+                const int n_used = static_cast<int>(tile_n_processed[pixel_idx]) - bucket_start;
+                if (n_used > 0) { // otherwise this pixel finished before the bucket: no checkpoint was written
+                    lim[r] = n_used;
+                    G = make_float3(grad_image[pixel_idx], grad_image[n_pixels + pixel_idx], grad_image[2 * n_pixels + pixel_idx]);
+                    const float3 color_final = make_float3(image[pixel_idx], image[n_pixels + pixel_idx], image[2 * n_pixels + pixel_idx]);
+                    const float4 color_transmittance = checkpoint[local_idx];
+                    T[r] = color_transmittance.w;
+                    rho[r] = dot(G, color_final - make_float3(color_transmittance));
+                }
+            }
+            s_grad[warp_idx][local_idx] = G;
+        }
+        __syncwarp();
+
+        for (int j = 0; j < bucket_size; ++j) {
+            const float2 mean2d = s_mean2d[warp_idx][j];
+            const float4 conic_opacity = s_conic_opacity[warp_idx][j];
+            const float3 color = s_color[warp_idx][j];
+            const uint flags = s_flags[warp_idx][j];
+            const float opacity = conic_opacity.w;
+            // a: 0-1 mean2d, 2-4 conic, 5-7 color;  b: 0 opacity, 1-2 |mean2d|
+            float a[8];
+            float b[3];
+            #pragma unroll
+            for (int k = 0; k < 8; ++k) a[k] = 0.0f;
+            #pragma unroll
+            for (int k = 0; k < 3; ++k) b[k] = 0.0f;
+            bool used = false;
+            #pragma unroll
+            for (int r = 0; r < n_px; ++r) {
+                if constexpr (subtile_skip) {
+                    if ((flags & (32u << (r / steps_per_subtile_row))) == 0u) continue; // warp-uniform
+                    if ((flags & x_half_bit) == 0u) continue;
+                }
+                if (j >= lim[r]) continue;
+                const float2 delta = make_float2(mean2d.x - pixel_xf, mean2d.y - (__uint2float_rn(pixel_y0 + r * rows_per_step) + 0.5f));
+                const float exponent = -0.5f * (conic_opacity.x * delta.x * delta.x + conic_opacity.z * delta.y * delta.y) - conic_opacity.y * delta.x * delta.y;
+                const float gaussian = expf(fminf(exponent, 0.0f));
+                if (!config::original_opacity_interpretation && gaussian < config::min_alpha_threshold) continue;
+                const float alpha = opacity * gaussian;
+                if (config::original_opacity_interpretation && alpha < config::min_alpha_threshold) continue;
+                used = true;
+                const float3 G = s_grad[warp_idx][r * 32 + lane_idx];
+                const float blending_weight = T[r] * alpha;
+                const float dot_color = dot(G, color);
+                a[5] += blending_weight * G.x;
+                a[6] += blending_weight * G.y;
+                a[7] += blending_weight * G.z;
+                rho[r] -= blending_weight * dot_color;
+                const float one_minus_alpha = 1.0f - alpha;
+                const float one_minus_alpha_rcp = 1.0f / fmaxf(one_minus_alpha, config::one_minus_alpha_eps);
+                const float dL_dalpha = T[r] * dot_color - rho[r] * one_minus_alpha_rcp;
+                b[0] += gaussian * dL_dalpha;
+                const float gaussian_grad_helper = -alpha * dL_dalpha;
+                a[2] += 0.5f * gaussian_grad_helper * delta.x * delta.x;
+                a[3] += 0.5f * gaussian_grad_helper * delta.x * delta.y;
+                a[4] += 0.5f * gaussian_grad_helper * delta.y * delta.y;
+                const float dmx = gaussian_grad_helper * (conic_opacity.x * delta.x + conic_opacity.y * delta.y);
+                const float dmy = gaussian_grad_helper * (conic_opacity.y * delta.x + conic_opacity.z * delta.y);
+                a[0] += dmx;
+                a[1] += dmy;
+                if constexpr (compute_abs_grad) {
+                    b[1] += fabsf(dmx);
+                    b[2] += fabsf(dmy);
+                }
+                T[r] *= one_minus_alpha;
+            }
+            if (__ballot_sync(full_mask, used) == 0u) continue; // warp-uniform
+
+            const uint primitive_idx = s_primitive_idx[warp_idx][j];
+            const float opacity_factor = proper_antialiasing ? 1.0f : opacity * (1.0f - opacity);
+            if constexpr (transpose_reduce) {
+                // a: 8 values -> value k ends in lanes with bits (4, 3, 2) = (k >> 2, k >> 1, k) & 1
+                const bool h4 = lane_idx & 16u, h3 = lane_idx & 8u, h2 = lane_idx & 4u;
+                #pragma unroll
+                for (int i = 0; i < 4; ++i) {
+                    const float keep = h4 ? a[i + 4] : a[i];
+                    const float send = h4 ? a[i] : a[i + 4];
+                    a[i] = keep + __shfl_xor_sync(full_mask, send, 16);
+                }
+                #pragma unroll
+                for (int i = 0; i < 2; ++i) {
+                    const float keep = h3 ? a[i + 2] : a[i];
+                    const float send = h3 ? a[i] : a[i + 2];
+                    a[i] = keep + __shfl_xor_sync(full_mask, send, 8);
+                }
+                {
+                    const float keep = h2 ? a[1] : a[0];
+                    const float send = h2 ? a[0] : a[1];
+                    a[0] = keep + __shfl_xor_sync(full_mask, send, 4);
+                }
+                a[0] += __shfl_xor_sync(full_mask, a[0], 2);
+                a[0] += __shfl_xor_sync(full_mask, a[0], 1);
+                // b: opacity (+ |mean2d|) -> value k in lanes with bits (4, 3) = (k >> 1, k) & 1
+                float bv;
+                if constexpr (compute_abs_grad) {
+                    float b2[2];
+                    #pragma unroll
+                    for (int i = 0; i < 2; ++i) {
+                        const float lo = b[i], hi = (i == 0) ? b[2] : 0.0f;
+                        const float keep = h4 ? hi : lo;
+                        const float send = h4 ? lo : hi;
+                        b2[i] = keep + __shfl_xor_sync(full_mask, send, 16);
+                    }
+                    const float keep = h3 ? b2[1] : b2[0];
+                    const float send = h3 ? b2[0] : b2[1];
+                    bv = keep + __shfl_xor_sync(full_mask, send, 8);
+                    bv += __shfl_xor_sync(full_mask, bv, 4);
+                } else {
+                    bv = b[0] + __shfl_xor_sync(full_mask, b[0], 16);
+                    bv += __shfl_xor_sync(full_mask, bv, 8);
+                    bv += __shfl_xor_sync(full_mask, bv, 4);
+                }
+                bv += __shfl_xor_sync(full_mask, bv, 2);
+                bv += __shfl_xor_sync(full_mask, bv, 1);
+                const uint sub = lane_idx & 3u;
+                const uint k = ((lane_idx >> 4) & 1u) * 4 + ((lane_idx >> 3) & 1u) * 2 + ((lane_idx >> 2) & 1u);
+                if (sub == 0u) {
+                    const uint color_mask = flags & 7u;
+                    float* target;
+                    float value = a[0];
+                    switch (k) {
+                        case 0: target = &grad_mean2d[primitive_idx].x; break;
+                        case 1: target = &grad_mean2d[primitive_idx].y; break;
+                        case 2: target = &grad_conic[primitive_idx]; break;
+                        case 3: target = &grad_conic[n_primitives + primitive_idx]; break;
+                        case 4: target = &grad_conic[2 * n_primitives + primitive_idx]; break;
+                        case 5: target = &grad_sh_coefficients_0[primitive_idx].x; if (!(color_mask & 1u)) value = 0.0f; break;
+                        case 6: target = &grad_sh_coefficients_0[primitive_idx].y; if (!(color_mask & 2u)) value = 0.0f; break;
+                        default: target = &grad_sh_coefficients_0[primitive_idx].z; if (!(color_mask & 4u)) value = 0.0f; break;
+                    }
+                    atomicAdd(target, value);
+                } else if ((lane_idx & 7u) == 1u) { // one lane per value: b is replicated over lane bits 2-0
+                    const uint kb = (lane_idx >> 3) & 3u; // bits (4, 3)
+                    if (kb == 0u) atomicAdd(&grad_opacity[primitive_idx], opacity_factor * bv);
+                    if constexpr (compute_abs_grad) {
+                        if (kb == 1u) atomicAdd(&grad_mean2d_abs[primitive_idx].x, bv);
+                        if (kb == 2u) atomicAdd(&grad_mean2d_abs[primitive_idx].y, bv);
+                    }
+                }
+            } else {
+                #pragma unroll
+                for (int k = 0; k < 8; ++k) {
+                    #pragma unroll
+                    for (int offset = 16; offset > 0; offset /= 2) a[k] += __shfl_down_sync(full_mask, a[k], offset);
+                }
+                #pragma unroll
+                for (int k = 0; k < (compute_abs_grad ? 3 : 1); ++k) {
+                    #pragma unroll
+                    for (int offset = 16; offset > 0; offset /= 2) b[k] += __shfl_down_sync(full_mask, b[k], offset);
+                }
+                if (lane_idx == 0) {
+                    const uint color_mask = flags & 7u;
+                    atomicAdd(&grad_mean2d[primitive_idx].x, a[0]);
+                    atomicAdd(&grad_mean2d[primitive_idx].y, a[1]);
+                    if constexpr (compute_abs_grad) {
+                        atomicAdd(&grad_mean2d_abs[primitive_idx].x, b[1]);
+                        atomicAdd(&grad_mean2d_abs[primitive_idx].y, b[2]);
+                    }
+                    atomicAdd(&grad_conic[primitive_idx], a[2]);
+                    atomicAdd(&grad_conic[n_primitives + primitive_idx], a[3]);
+                    atomicAdd(&grad_conic[2 * n_primitives + primitive_idx], a[4]);
+                    atomicAdd(&grad_opacity[primitive_idx], opacity_factor * b[0]);
+                    atomicAdd(&grad_sh_coefficients_0[primitive_idx].x, (color_mask & 1u) ? a[5] : 0.0f);
+                    atomicAdd(&grad_sh_coefficients_0[primitive_idx].y, (color_mask & 2u) ? a[6] : 0.0f);
+                    atomicAdd(&grad_sh_coefficients_0[primitive_idx].z, (color_mask & 4u) ? a[7] : 0.0f);
+                }
+            }
+        }
+    }
+
 }
