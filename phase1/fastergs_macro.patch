+#                                prints GRADCHECK lines: norm-based rel error of each gradient (reference = taming)
+#   FGS_BWDTIME_REPS=k           on those calls, also time k runs of _C.backward per kernel (CUDA events, median ms)
+MACRO_DEFAULT = 3  # macro + subtile skip: as fast as v1 (1) and replays exactly the forward's splats; 4 and 8 were slower (results/phase1/macro_backward.md)
+BLEND_BACKWARD_MODES = {'taming': 0, 'macro1': 1, 'macro': MACRO_DEFAULT}
+
+
+def parse_blend_backward_mode(value: str) -> int:
+    return int(value) if value.isdigit() else BLEND_BACKWARD_MODES[value]
+
