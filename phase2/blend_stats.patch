+++ b/FasterGSCudaBackend/FasterGSCudaBackend/rasterization/src/stats_host.inc
@@ -0,0 +1,41 @@
+// phase2 blend stats (stats build only): FGS_BLENDSTATS="5000,20000" zeroes this file's kernel counters on those calls
+// and prints them 50 calls later (one call per training step), as one line on stdout.
+template <typename Sym, size_t N>
+static void fgs_blend_stats_tick(const char* tag, Sym& symbol, const char* const (&names)[N]) {
+    static long call = -1, window_end = -1;
+    static std::vector<long> starts;
+    static bool init = false;
+    constexpr long len = 50;
+    if (!init) {
+        init = true;
+        if (const char* e = std::getenv("FGS_BLENDSTATS")) {
+            std::string s(e);
+            size_t p = 0;
+            while (p < s.size()) {
+                const size_t q = s.find(',', p);
+                starts.push_back(std::stol(s.substr(p, q == std::string::npos ? std::string::npos : q - p)));
+                if (q == std::string::npos) break;
+                p = q + 1;
+            }
+        }
+    }
+    call++;
+    if (window_end >= 0 && call == window_end) {
+        unsigned long long h[N];
+        cudaDeviceSynchronize();
+        cudaMemcpyFromSymbol(h, symbol, sizeof(h));
+        std::printf("%s start=%ld calls=%ld", tag, window_end - len, len);
+        for (size_t i = 0; i < N; ++i) std::printf(" %s=%llu", names[i], h[i]);
+        std::printf("\n");
+        std::fflush(stdout);
+        window_end = -1;
+    }
+    for (const long st : starts) {
+        if (call == st) {
+            unsigned long long z[N] = {};
+            cudaDeviceSynchronize();
+            cudaMemcpyToSymbol(symbol, z, sizeof(z));
+            window_end = st + len;
+        }
+    }
+}
