+    // phase2 step 5h: the same SH backward on one Gaussian's SH-rest row in shared memory (row[3k + c] = coefficient k,
+    // channel c). Each band's coefficients are read before its gradients overwrite them, so the row ends up holding the
+    // gradient. Bands above active_sh_bases get zero (the global gradient buffer starts at zero and the original kernel
+    // leaves them untouched). Arithmetic order matches convert_sh_to_color_backward.
+    __device__ inline float3 convert_sh_to_color_backward_row(
+        float* __restrict__ row,
+        float3* __restrict__ grad_sh_coefficients_0,
+        const float3& position,
+        const float3& cam_position,
+        const uint primitive_idx,
+        const uint active_sh_bases,
+        const uint total_sh_bases_rest)
+    {
+        auto c = [&](int k) { return make_float3(row[3 * k], row[3 * k + 1], row[3 * k + 2]); };
+        auto set = [&](int k, const float3 v) { row[3 * k] = v.x; row[3 * k + 1] = v.y; row[3 * k + 2] = v.z; };
+        const float3 grad_color = grad_sh_coefficients_0[primitive_idx];
+        grad_sh_coefficients_0[primitive_idx] = C0 * grad_color;
+        float3 dcolor_dposition = make_float3(0.0f);
+        uint written = 0;
+        if (active_sh_bases > 1) {
+            auto [x_raw, y_raw, z_raw] = position - cam_position;
+            auto [x, y, z] = normalize(make_float3(x_raw, y_raw, z_raw));
+            float3 grad_direction_x = -C1 * c(2);
+            float3 grad_direction_y = -C1 * c(0);
+            float3 grad_direction_z = C1 * c(1);
+            set(0, -C1 * y * grad_color);
+            set(1, C1 * z * grad_color);
+            set(2, -C1 * x * grad_color);
+            written = 3;
+            if (active_sh_bases > 4) {
+                const float xx = x * x, yy = y * y, zz = z * z;
+                const float xy = x * y, xz = x * z, yz = y * z;
+                grad_direction_x = grad_direction_x + C2a * y * c(3)
+                                                    - C2a * z * c(6)
+                                                    + C2a * x * c(7);
+                grad_direction_y = grad_direction_y + C2a * x * c(3)
+                                                    - C2a * z * c(4)
+                                                    - C2a * y * c(7);
+                grad_direction_z = grad_direction_z - C2a * y * c(4)
+                                                    + C2e * z * c(5)
+                                                    - C2a * x * c(6);
+                set(3, C2a * xy * grad_color);
+                set(4, -C2a * yz * grad_color);
+                set(5, (C2b * zz - C2c) * grad_color);
+                set(6, -C2a * xz * grad_color);
+                set(7, C2d * (xx - yy) * grad_color);
+                written = 8;
+                if (active_sh_bases > 9) {
+                    grad_direction_x = grad_direction_x - C3i * xy * c(8)
+                                                        + C3c * yz * c(9)
+                                                        + (C3d - C3e * zz) * c(12)
+                                                        + C3c * xz * c(13)
+                                                        + C3b * (yy - xx) * c(14);
+                    grad_direction_y = grad_direction_y + C3b * (yy - xx) * c(8)
+                                                        + C3c * xz * c(9)
+                                                        + (C3d - C3e * zz) * c(10)
+                                                        - C3c * yz * c(13)
+                                                        + C3i * xy * c(14);
+                    grad_direction_z = grad_direction_z + C3c * xy * c(9)
+                                                        - C3j * yz * c(10)
+                                                        + (C3k * zz - C3g) * c(11)
+                                                        - C3j * xz * c(12)
+                                                        + C3h * (xx - yy) * c(13);
+                    set(8, y * (C3a * yy - C3b * xx) * grad_color);
+                    set(9, C3c * xy * z * grad_color);
+                    set(10, y * (C3d - C3e * zz) * grad_color);
+                    set(11, z * (C3f * zz - C3g) * grad_color);
+                    set(12, x * (C3d - C3e * zz) * grad_color);
+                    set(13, C3h * z * (xx - yy) * grad_color);
+                    set(14, x * (C3b * yy - C3a * xx) * grad_color);
+                    written = 15;
+                }
+            }
+
+            const float3 grad_direction = make_float3(
+                dot(grad_direction_x, grad_color),
+                dot(grad_direction_y, grad_color),
+                dot(grad_direction_z, grad_color)
+            );
+            const float xx_raw = x_raw * x_raw, yy_raw = y_raw * y_raw, zz_raw = z_raw * z_raw;
+            const float xy_raw = x_raw * y_raw, xz_raw = x_raw * z_raw, yz_raw = y_raw * z_raw;
+            const float norm_sq = xx_raw + yy_raw + zz_raw;
+            dcolor_dposition = make_float3(
+                (yy_raw + zz_raw) * grad_direction.x - xy_raw * grad_direction.y - xz_raw * grad_direction.z,
+                -xy_raw * grad_direction.x + (xx_raw + zz_raw) * grad_direction.y - yz_raw * grad_direction.z,
+                -xz_raw * grad_direction.x - yz_raw * grad_direction.y + (xx_raw + yy_raw) * grad_direction.z
+            ) * rsqrtf(norm_sq * norm_sq * norm_sq);
+        }
+        for (uint k = 3 * written; k < 3 * total_sh_bases_rest; ++k) row[k] = 0.0f;
+        return dcolor_dposition;
+    }
+
 }
